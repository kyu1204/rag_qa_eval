# Postgres (docker compose 기본값과 일치)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Elice ML API (OpenAI 호환). 모델마다 endpoint-id가 다르다. 키는 커밋 금지.
ELICE_API_KEY=
EMBED_BASE_URL=https://mlapi.run/<embed-endpoint-id>/v1
EMBED_MODEL=
EMBED_DIM=1536

# 기준선: generic + split. 개선안: policy_book + policy(정책 1건 = 청크 1개)
EXTRACTOR=generic
CHUNK_STRATEGY=split
CHUNK_TOKENS=500
CHUNK_OVERLAP=75

# 프로덕션 서비스 설정: Part C 실험 5 종합 (top_k 30, README 9.5절)
# 유용성 89.9%, 안전성 100%, 오거절 0%. 대가는 질의당 생성 비용 약 ₩5.7, p95 13.5초
# 사용: uv run --env-file .env.prod uvicorn app.api:app
#   이 파일 값이 .env보다 우선하고, 키와 엔드포인트는 그대로 .env에서 읽는다. 이 파일은 커밋되므로 키를 넣지 않는다
# 서비스 전용이다. eval에서 같은 설정은 --exp combined-k30으로 돌린다 (이 파일을 켠 채 --exp 실험을 돌리면 실험 설정이 달라진다)
LLM_REASONING_EFFORT=medium
RAG_PROMPT=v3
TOP_K=30
